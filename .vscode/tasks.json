{
  // Tasks for validating Home Assistant blueprints.
  // All entries delegate to scripts/validate-blueprints.sh so behaviour stays
  // identical between local runs, the command palette, and CI.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Validate blueprints",
      "detail": "YAML+!input parse and HA check_config (Docker) for every blueprint",
      "type": "shell",
      "command": "bash",
      "args": ["scripts/validate-blueprints.sh"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Validate current blueprint",
      "detail": "Run both layers against the file open in the editor",
      "type": "shell",
      "command": "bash",
      "args": ["scripts/validate-blueprints.sh", "${relativeFile}"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
